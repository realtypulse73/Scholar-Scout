{
  "name": "scholar-scout",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "20.x",
    "pnpm": "10.34.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @scholar-scout/web run dev",
    "dev:web": "pnpm --filter @scholar-scout/web run dev",
    "build": "pnpm --recursive --if-present run build",
    "build:web": "pnpm --filter @scholar-scout/web run build",
    "build:vercel": "pnpm --filter @scholar-scout/web run build",
    "vercel:docker-free": "pnpm install --frozen-lockfile --ignore-scripts && pnpm run build:vercel",
    "build:apps": "pnpm --filter @scholar-scout/web run build",
    "lint": "pnpm --recursive --if-present run lint",
    "check:production-env": "node scripts/production-env-check.mjs",
    "provision:env": "node scripts/provision-environment.mjs",
    "provision:production-values": "node scripts/provision-production-values.mjs",
    "rehearse:prelaunch": "node scripts/prelaunch-rehearsal.mjs",
    "report:production": "node scripts/production-report-summary.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "test:production-tooling": "node --test scripts/test-production-tooling.mjs",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "ts-node": "^10.9.2"
  }
}
